# Leave unset to use the Vite dev proxy, which forwards /api to the local API server.
# Set only when the API runs somewhere else (e.g. a deployed backend).
# VITE_API_BASE_URL=http://localhost:3000/api

# Overrides the dev proxy target used by vite.config.ts.
# API_PROXY_TARGET=http://localhost:3000

# For a Capacitor Android release, set this to the deployed Render URL before building.
# VITE_API_BASE_URL=https://your-service.onrender.com/api
# Render free services may need up to a minute to wake after inactivity.
# VITE_API_TIMEOUT_MS=70000

# API server: allowed browser and Capacitor WebView origins (comma-separated).
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

# Explicitly seed the demo administrator in a production-like environment.
# SEED_DEMO_ACCOUNT=true
