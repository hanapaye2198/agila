# Leave unset to use the Vite dev proxy, which forwards /api to the local API server.
# Set only when the API runs somewhere else (e.g. a deployed backend).
# VITE_API_BASE_URL=http://localhost:3000/api

# Overrides the dev proxy target used by vite.config.ts.
# API_PROXY_TARGET=http://localhost:3000

# For a Capacitor Android release, set this to the deployed Render URL before building.
# VITE_API_BASE_URL=https://your-service.onrender.com/api
